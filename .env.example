# Nothing is uploaded by default. Do not set an API URL or enable a server for real
# health data until hosting, processor, privacy, transport and retention are approved.
VITE_FITFLOW_API_URL=
FITFLOW_SERVER_ENABLED=false
# Separate recipient/category-consented coaching API; synthetic-only until reviewed.
FITFLOW_COACHING_ENABLED=false
FITFLOW_SERVER_HOST=127.0.0.1
FITFLOW_SERVER_PORT=3001
FITFLOW_APP_ORIGIN=https://localhost
FITFLOW_DATABASE_PATH=./.fitflow-data/fitflow.sqlite
FITFLOW_ALLOW_INSECURE_LOCALHOST=false

# Synthetic loopback development only (same localhost hostname on app and API):
# FITFLOW_SERVER_ENABLED=true
# FITFLOW_APP_ORIGIN=http://localhost:5173
# FITFLOW_ALLOW_INSECURE_LOCALHOST=true
# No mail credentials or development token-logging mode exist.

# Optional browser API base; leave blank to send no account/cloud requests.
# Must be an approved same-site HTTPS endpoint in production, usually behind /api/v1.
